// Leitura automática: XML estruturado, PDF com texto, OCR de PDF escaneado e formatos textuais.
function descendants(root){ return [...(root?.getElementsByTagName?.('*')||[])]; }
function firstTag(root,names){
  if(!root)return '';
  const wanted=names.map(n=>n.toLowerCase());
  for(const el of descendants(root)) if(wanted.includes((el.localName||el.nodeName||'').toLowerCase()) && el.textContent.trim()) return el.textContent.trim();
  return '';
}
function firstNode(root,names){
  const wanted=names.map(n=>n.toLowerCase());
  const candidates=[root,...descendants(root)];
  return candidates.find(el=>wanted.includes((el.localName||el.nodeName||'').toLowerCase()))||null;
}
function textIn(root,names){
  if(!root)return '';
  const selfName=(root.localName||root.nodeName||'').toLowerCase();
  const wanted=names.map(n=>n.toLowerCase());
  if(wanted.includes(selfName)&&root.textContent?.trim())return root.textContent.trim();
  return firstTag(root,names);
}
function parseCurrency(value){
  if(value===undefined||value===null||value==='')return null;
  let s=String(value).trim().replace(/[^\d,.-]/g,'');
  if(!s)return null;
  if(s.includes(',')&&s.includes('.'))s=s.replace(/\./g,'').replace(',','.');
  else if(s.includes(','))s=s.replace(',','.');
  const n=Number(s);return Number.isFinite(n)?n:null;
}
function uniqueJoin(values,separator=' | '){return [...new Set(values.map(v=>String(v||'').trim()).filter(Boolean))].join(separator);}
function normalizeDateValue(value){
  const s=String(value||'').trim();
  const iso=s.match(/^(\d{4}-\d{2}-\d{2})/);if(iso)return iso[1];
  const br=s.match(/^(\d{2})\/(\d{2})\/(\d{4})/);if(br)return `${br[3]}-${br[2]}-${br[1]}`;
  return s;
}
function makeExtraction(data){
  const fields=[
    ['Número',data.docNumber],['Data de emissão',data.issueDate],['CNPJ do emitente',data.cnpj],
    ['Razão social do prestador',data.companyName],['CNPJ do tomador',data.buyerCnpj],['Tomador / comprador',data.buyerName],['Descrição',data.description],['Código fiscal',data.serviceCode],
    ['Valor total',data.gross!==null&&data.gross!==undefined?brl(data.gross):''],['Regime indicado no documento',data.providerRegime==='simples'?'MEI / Simples Nacional':''],['ISS informado',data.issStatus==='no'?'Não retido':''],['Município do prestador',data.supplierCity],['Município do tomador',data.buyerCity]
  ];
  const found=fields.filter(([,v])=>String(v??'').trim()!==''&&String(v)!=='0');
  return {fields:fields.map(([label,value])=>({label,value:value===null||value===undefined?'':String(value)})),foundCount:found.length,totalCount:fields.length};
}
function extractXML(text,fileName){
  const xml=new DOMParser().parseFromString(text,'application/xml');
  if(xml.querySelector('parsererror'))return null;
  const root=xml.documentElement;
  const hasNfe=!!(xml.getElementsByTagNameNS('*','infNFe').length||firstNode(root,['infNFe']));
  const nfseNames=['infNFSe','InfNfse','CompNfse','DPS','infDPS','Nfse'];
  const hasNfse=nfseNames.some(name=>!!firstNode(root,[name]));
  const docType=hasNfe?'nfe':hasNfse?'nfse':'outro';
  let issuer=null, buyer=null, total=null, docNumber='',issueDate='',companyName='',issuerCnpj='',description='',serviceCode='',supplierCity='',buyerCity='',buyerName='',buyerCnpj='',providerRegime='';
  const taxes=[];
  if(hasNfe){
    const emit=firstNode(root,['emit'])||root;
    const ide=firstNode(root,['ide'])||root;
    const tot=firstNode(root,['ICMSTot'])||root;
    const dets=descendants(root).filter(el=>(el.localName||'').toLowerCase()==='det');
    issuer=emit;buyer=firstNode(root,['dest']);
    issuerCnpj=textIn(emit,['CNPJ','CNPJAlfa']);
    companyName=textIn(emit,['xNome']);buyerName=textIn(buyer,['xNome']);buyerCnpj=textIn(buyer,['CNPJ','CNPJAlfa']);
    docNumber=textIn(ide,['nNF']);
    issueDate=normalizeDateValue(textIn(ide,['dhEmi','dEmi']));
    total=parseCurrency(textIn(tot,['vNF'])||textIn(root,['vNF']));
    description=uniqueJoin(dets.map(det=>textIn(det,['xProd'])), ' | ');
    serviceCode=uniqueJoin(dets.flatMap(det=>[textIn(det,['NCM']),textIn(det,['CFOP'])]),' / ');
    supplierCity=textIn(firstNode(emit,['enderEmit'])||emit,['xMun','cMun']);
    buyerCity=textIn(firstNode(buyer||root,['enderDest'])||buyer||root,['xMun']);
    const taxMap=[['ICMS','vICMS'],['ICMS-ST','vICMSST'],['IPI','vIPI'],['PIS','vPIS'],['COFINS','vCOFINS'],['CBS','vCBS'],['IBS','vIBS']];
    for(const [label,tag] of taxMap){const value=parseCurrency(textIn(tot,[tag]));if(value!==null&&value>0)taxes.push({name:label,value});}
  }else if(hasNfse){
    issuer=firstNode(root,['PrestadorServico','prest','emit'])||root;
    buyer=firstNode(root,['TomadorServico','toma','dest']);
    const inf=firstNode(root,['InfNfse','infNFSe','infDPS'])||root;
    const service=firstNode(root,['Servico','serv'])||root;
    const values=firstNode(root,['Valores','valores'])||root;
    issuerCnpj=textIn(issuer,['Cnpj','CNPJ','CNPJPrestador']);
    companyName=textIn(issuer,['RazaoSocial','xNome','NomeRazaoSocial']);buyerName=textIn(buyer,['RazaoSocial','xNome','NomeRazaoSocial']);buyerCnpj=textIn(buyer,['Cnpj','CNPJ','CpfCnpj','CNPJTomador']);
    providerRegime=/MEI/i.test(textIn(root,['RegimeEspecialTributacao','opSimpNac','RegimeTributario']))?'simples':'';
    docNumber=textIn(inf,['Numero','nNFSe','numero','nDPS'])||textIn(root,['Numero','nNFSe','nDPS']);
    issueDate=normalizeDateValue(textIn(inf,['DataEmissao','dhEmi','dCompet','dhProc'])||textIn(root,['DataEmissao','dhEmi']));
    total=parseCurrency(textIn(values,['ValorServicos','vServ','ValorLiquidoNfse','valorServicos'])||textIn(root,['ValorServicos','vServ','ValorLiquidoNfse']));
    description=textIn(service,['Discriminacao','xDescServ','DescricaoServico','discriminacao']);
    serviceCode=textIn(service,['ItemListaServico','cTribNac','CodigoTributacaoMunicipio','CodigoServico','cTribMun']);
    supplierCity=textIn(firstNode(issuer,['Endereco','end','ender'])||issuer,['xMun','Municipio','Cidade','cidade','CodigoMunicipio']);
    buyerCity=textIn(firstNode(buyer||root,['Endereco','end','ender'])||buyer||root,['xMun','Municipio','Cidade','cidade','CodigoMunicipio']);
    const taxMap=[['ISS','ValorIss','vISS','ValorISSQN'],['PIS','ValorPis','vPis'],['COFINS','ValorCofins','vCofins'],['INSS','ValorInss','vInss'],['IR','ValorIr','vIR'],['CSLL','ValorCsll','vCSLL']];
    for(const [label,...tags] of taxMap){const value=parseCurrency(textIn(values,tags)||textIn(root,tags));if(value!==null&&value>0)taxes.push({name:label,value});}
  }
  if(!issuerCnpj)issuerCnpj=textIn(issuer||root,['CNPJ','Cnpj']);
  const data={fileName,docType,docNumber,issueDate,cnpj:issuerCnpj,companyName,buyerName,buyerCnpj,providerRegime,issStatus:'',description,serviceCode,gross:total,taxes,supplierCity,buyerCity,readMethod:'XML estruturado',readError:''};
  if(!hasNfe&&!hasNfse)data.readError='XML aberto, mas o leiaute não foi reconhecido como NF-e ou NFS-e. Confira o documento.';
  return data;
}
function parseTextDoc(text,fileName,readMethod='Texto extraído'){
  const flat=String(text||'').replace(/\r/g,'');
  const data={fileName,docType:/NF-e|DANFE|chave de acesso.*\b55\b/i.test(flat)?'nfe':'nfse',docNumber:'',issueDate:'',cnpj:'',companyName:'',buyerName:'',buyerCnpj:'',providerRegime:'',issStatus:'',description:'',serviceCode:'',gross:null,taxes:[],supplierCity:'',buyerCity:'',readMethod,readError:''};
  if(/^\s*\{/.test(flat)){
    try{
      const obj=JSON.parse(flat);
      const find=(...keys)=>{for(const key of keys){const v=key.split('.').reduce((o,k)=>o?.[k],obj);if(v!==undefined&&v!==null&&v!=='')return String(v);}return '';};
      data.docNumber=find('numero','numero_nota','nNF','ide.nNF','numero_nfse');
      data.issueDate=normalizeDateValue(find('data_emissao','dataEmissao','dhEmi','ide.dhEmi'));
      data.cnpj=find('cnpj','emitente.cnpj','emit.CNPJ','prestador.cnpj');
      data.companyName=find('razao_social','emitente.razao_social','emit.xNome','prestador.razao_social');
      data.description=find('descricao','discriminacao','servico.discriminacao','xProd');
      data.serviceCode=find('codigo_servico','item_lista_servico','CFOP','NCM','cTribNac');
      data.gross=parseCurrency(find('valor_total','valor_servicos','vNF','valor','valor_liquido'));
      data.supplierCity=find('emitente.municipio','prestador.municipio','xMun');
      data.readMethod='JSON estruturado';
      return data;
    }catch(_){/* continua pela leitura de texto */}
  }
  const match=(re)=>{const m=flat.match(re);return m?m[1].trim():'';};
  data.docNumber=match(/(?:NFS-?e|NF-?e|N[úu]mero(?: da nota)?|N[º°])\s*(?:n[ºo.]*)?\s*[:#-]?\s*(\d{1,20})/i);
  data.issueDate=normalizeDateValue(match(/(?:data\s+(?:de\s+)?emiss[aã]o|emiss[aã]o)\D{0,24}(\d{2}\/\d{2}\/\d{4}|\d{4}-\d{2}-\d{2})/i));
  let cnpjMatch=flat.match(/(?:CNPJ|CPF\/CNPJ)\D{0,15}([0-9A-Z]{2}\.?[0-9A-Z]{3}\.?[0-9A-Z]{3}\/?[0-9A-Z]{4}-?\d{2})/i);
  if(!cnpjMatch)cnpjMatch=flat.match(/\b([0-9A-Z]{2}\.[0-9A-Z]{3}\.[0-9A-Z]{3}\/[0-9A-Z]{4}-\d{2})\b/i);
  data.cnpj=cnpjMatch?cnpjMatch[1]:'';
  data.companyName=match(/(?:Raz[aã]o\s+Social|Nome\s*\/\s*Raz[aã]o\s+Social|Prestador\s+de\s+Servi[cç]os?)\s*[:\-]?\s*([^\n]{3,})/i);
  data.description=match(/(?:Discrimina[cç][aã]o(?:\s+dos\s+Servi[cç]os?)?|Descri[cç][aã]o\s+do\s+Servi[cç]o|Descri[cç][aã]o\s+dos\s+Produtos?|Descri[cç][aã]o)\s*[:\-]?\s*([^\n]{5,})/i);
  data.serviceCode=match(/(?:C[oó]digo\s+(?:de\s+)?Servi[cç]o|CNAE|CFOP|NCM|Item\s+da\s+Lista\s+de\s+Servi[cç]os?)\s*[:\-]?\s*([\w.\/-]+)/i);
  const valuePatterns=[
    /(?:Valor\s+Total\s+da\s+Nota|Valor\s+Total\s+da\s+NFS-?e|Valor\s+Total\s+dos\s+Servi[cç]os|Valor\s+dos\s+Servi[cç]os|Valor\s+Total\s+da\s+Opera[cç][aã]o|Valor\s+Total)\D{0,25}(?:R\$\s*)?([\d.]+,\d{2})/i,
    /(?:Valor\s+L[ií]quido|Valor\s+da\s+Nota)\D{0,25}(?:R\$\s*)?([\d.]+,\d{2})/i
  ];
  for(const re of valuePatterns){const v=match(re);if(v){data.gross=parseCurrency(v);break;}}
  data.supplierCity=match(/(?:Munic[ií]pio\s+do\s+Prestador|Munic[ií]pio\s+de\s+Incid[eê]ncia)\s*[:\-]?\s*([^\n]{3,})/i);

  // Campos específicos do DANFSe nacional v2.0, cujas tabelas podem ser extraídas em blocos separados.
  const section=(start,end)=>{const a=flat.search(start);if(a<0)return '';const from=a+(flat.slice(a).match(start)?.[0].length||0);const rest=flat.slice(from);const b=rest.search(end);return (b<0?rest:rest.slice(0,b)).trim();};
  if(/DANFSe\s*v2\.0|Documento Auxiliar da NFS-e/i.test(flat)){
    data.docType='nfse';
    data.docNumber=match(/N[ÚU]MERO\s+DA\s+NFS-?e\s*[:\n]*\s*(\d{1,20})/i)||data.docNumber;
    data.issueDate=normalizeDateValue(match(/DATA\s+E\s+HORA\s+DA\s+EMISS[AÃ]O\s+DA\s+NFS-?e\s*[:\n]*\s*(\d{2}\/\d{2}\/\d{4})/i)||data.issueDate);
    const prest=section(/PRESTADOR\s*\/\s*FORNECEDOR/i,/TOMADOR\s*\/\s*ADQUIRENTE/i);
    const toma=section(/TOMADOR\s*\/\s*ADQUIRENTE/i,/DESTINAT[AÁ]RIO\s+DA\s+OPERA[CÇ][AÃ]O/i);
    const cnpjIn=(block)=>{const m=block.match(/\b(\d{2}\.\d{3}\.\d{3}\/\d{4}-\d{2})\b/);return m?m[1]:'';};
    data.cnpj=cnpjIn(prest)||data.cnpj;data.buyerCnpj=cnpjIn(toma)||data.buyerCnpj;
    const cleanLines=(block)=>block.split('\n').map(x=>x.trim()).filter(x=>x&&!/^(PRESTADOR|TOMADOR|CNPJ|CPF|NIF|Indicador Municipal|Nome \/ Nome Empresarial|Munic[ií]pio \/ Sigla UF|Endere[cç]o|E-mail|Telefone|C[oó]digo IBGE|CEP|Situa[cç][aã]o|FINALIDADE|S[eé]rie|Regime de Apura[cç][aã]o|Simples Nacional|Optante -|\-|\d{2}\.\d{3}\.\d{3}\/\d{4}-\d{2})/i.test(x));
    const prestLines=cleanLines(prest);
    const buyerLines=cleanLines(toma);
    const plausibleName=(lines)=>lines.find(x=>/[A-ZÀ-Ú]{3}/.test(x)&&x.length>=6&&!/RUA |AVENIDA|TRAVESSA|RODOVIA|VILA |JARDIM |S[AÃ]O PAULO \/ SP|CAMPINAS \/ SP|BRASIL|@|\(\d{2}\)/i.test(x))||'';
    data.companyName=plausibleName(prestLines)||data.companyName;
    data.buyerName=plausibleName(buyerLines)||data.buyerName;
    const serviceBlock=section(/SERVI[CÇ]O\s+PRESTADO/i,/TRIBUTA[CÇ][AÃ]O\s+MUNICIPAL/i);
    const codeMatch=serviceBlock.match(/(\d{2}\.\d{2}\.\d{2})/);if(codeMatch)data.serviceCode=codeMatch[1];
    const descMatch=serviceBlock.match(/Descri[cç][aã]o\s+do\s+Servi[cç]o\s*[:\n]+\s*([^\n]+)/i);if(descMatch)data.description=descMatch[1].trim();
    if(!data.description){const candidate=serviceBlock.split('\n').map(x=>x.trim()).filter(x=>x.length>8&&!/Gin[aá]stica, dan[cç]a|C[oó]digo de Tributa[cç][aã]o|Local da Presta[cç][aã]o/i.test(x));if(candidate.length)data.description=candidate[candidate.length-1];}
    const location=serviceBlock.match(/Local da Presta[cç][aã]o[^\n]*\n\s*([^\n]+)/i);if(location)data.supplierCity=location[1].replace(/\s*\/\s*-.*$/,'').trim();
    const amountMatch=flat.match(/VALOR\s+DA\s+OPERA[CÇ][AÃ]O\s*\/\s*SERVI[CÇ]O[\s\S]{0,260}?R\$\s*([\d.]+,\d{2})/i);
    if(amountMatch)data.gross=parseCurrency(amountMatch[1]);
    data.buyerCity=buyerLines.find(x=>/\b[A-ZÀ-Ú][a-zà-ú]+\s*\/\s*[A-Z]{2}\b/.test(x))||data.buyerCity;
    if(/Optante\s*-\s*Microempreendedor Individual|NFS-e\s+MEI/i.test(flat))data.providerRegime='simples';
    if(/Reten[cç][aã]o\s+do\s+ISSQN\s+Não\s+Retido/i.test(flat))data.issStatus='no';
  }
  if(!data.description){
    const lines=flat.split('\n').map(line=>line.trim()).filter(Boolean);
    data.description=lines.find(line=>line.length>24&&!/CNPJ|CHAVE|NFS-?e|NF-?e|DANFE|http|VALOR|ENDERE[CÇ]O/i.test(line))||'';
  }
  return data;
}
let tesseractScriptPromise=null;
async function ensureTesseract(){
  if(window.Tesseract)return window.Tesseract;
  if(!tesseractScriptPromise){tesseractScriptPromise=new Promise((resolve,reject)=>{const script=document.createElement('script');script.src='https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js';script.onload=()=>resolve(window.Tesseract);script.onerror=()=>reject(new Error('Não foi possível carregar o mecanismo OCR. Verifique a conexão.'));document.head.appendChild(script);});}
  return tesseractScriptPromise;
}
async function extractImage(file){
  const Tesseract=await ensureTesseract();
  const worker=await Tesseract.createWorker('por',1,{logger:message=>{
    if(message.status==='recognizing text'&&message.progress!==undefined)$('fileStatus').textContent=`OCR em português: ${Math.round(message.progress*100)}% da imagem…`;
  }});
  try{const result=await worker.recognize(file);return {text:result.data.text||'',method:'OCR em português (imagem)'};}
  finally{await worker.terminate();}
}
async function extractPdf(file){
  if(!window.pdfjsLib)throw new Error('Biblioteca de PDF indisponível. Verifique a conexão e tente novamente.');
  const pdf=await pdfjsLib.getDocument({data:await file.arrayBuffer()}).promise;
  let text='';
  for(let p=1;p<=pdf.numPages;p++){
    const page=await pdf.getPage(p);const content=await page.getTextContent();
    text+=content.items.map(item=>item.str+(item.hasEOL?'\n':' ')).join('').trim()+'\n';
  }
  const compact=text.replace(/\s/g,'');
  const hasInvoiceClues=/(?:CNPJ|CPF|VALOR|NFS|NF-?e|EMISS|DANFE|PRESTADOR|TOMADOR)/i.test(text);
  if(compact.length>=45&&hasInvoiceClues)return {text,method:'Texto extraído do PDF'};
  $('fileStatus').textContent='PDF sem texto selecionável. Iniciando OCR em português…';
  const Tesseract=await ensureTesseract();
  const worker=await Tesseract.createWorker('por',1,{logger:message=>{
    if(message.status==='recognizing text'&&message.progress!==undefined)$('fileStatus').textContent=`OCR em português: ${Math.round(message.progress*100)}% da página…`;
  }});
  let ocrText='';
  try{
    const maxPages=Math.min(pdf.numPages,8);
    for(let p=1;p<=maxPages;p++){
      $('fileStatus').textContent=`OCR em português: lendo página ${p} de ${maxPages}…`;
      const page=await pdf.getPage(p);const base=page.getViewport({scale:1});const scale=Math.min(2,1800/base.width);const viewport=page.getViewport({scale});
      const canvas=document.createElement('canvas');canvas.width=Math.ceil(viewport.width);canvas.height=Math.ceil(viewport.height);
      const context=canvas.getContext('2d',{willReadFrequently:true});await page.render({canvasContext:context,viewport}).promise;
      const result=await worker.recognize(canvas);ocrText+=`\n${result.data.text||''}`;canvas.width=canvas.height=1;
    }
    if(pdf.numPages>maxPages)ocrText+=`\n[OCR limitado às primeiras ${maxPages} páginas de ${pdf.numPages}.]`;
  }finally{await worker.terminate();}
  if(!ocrText.trim())throw new Error('O OCR não conseguiu reconhecer texto neste PDF. Confira se está legível.');
  return {text:ocrText,method:'OCR em português (PDF escaneado)',ocrLimited:pdf.numPages>8};
}
async function parseFile(file){
  try{
    const extension=file.name.split('.').pop().toLowerCase();let text='',method='';
    if(extension==='pdf'){const result=await extractPdf(file);text=result.text;method=result.method;}
    else if(['png','jpg','jpeg','webp','bmp','tif','tiff'].includes(extension)){const result=await extractImage(file);text=result.text;method=result.method;}
    else{text=await file.text();method=extension==='xml'?'XML estruturado':'Texto do arquivo';}
    if(extension==='html'||extension==='htm'){const doc=new DOMParser().parseFromString(text,'text/html');text=doc.body?.textContent||'';}
    let data=extension==='xml'?extractXML(text,file.name):parseTextDoc(text,file.name,method);
    if(!data)data={fileName:file.name,docType:'outro',docNumber:'',issueDate:'',cnpj:'',companyName:'',buyerName:'',buyerCnpj:'',providerRegime:'',issStatus:'',description:'',serviceCode:'',gross:null,taxes:[],supplierCity:'',buyerCity:'',readMethod:method,readError:'XML inválido ou não reconhecido.'};
    data.buyerName=data.buyerName||'';data.buyerCnpj=data.buyerCnpj||'';data.readMethod=data.readMethod||method;
    const missing=[];
    if(!data.docNumber)missing.push('número');if(!data.issueDate)missing.push('data');if(!data.cnpj)missing.push('CNPJ');if(!data.companyName)missing.push('razão social');if(!data.description)missing.push('descrição');if(data.gross===null||data.gross===undefined)missing.push('valor total');
    const notes=[];
    if(missing.length)notes.push('Não identificado: '+missing.join(', ')+'.');
    if(data.readMethod.startsWith('OCR'))notes.push('Leitura por OCR: confira especialmente números, CNPJ e valores no documento original.');
    if(!data.docType||data.docType==='outro')notes.push('Tipo de documento não identificado automaticamente.');
    data.readError=[data.readError,...notes].filter(Boolean).join(' ');
    data.extraction=makeExtraction(data);
    return data;
  }catch(error){
    const data={fileName:file.name,docType:'outro',docNumber:'',issueDate:'',cnpj:'',companyName:'',buyerName:'',buyerCnpj:'',providerRegime:'',issStatus:'',description:'',serviceCode:'',gross:null,taxes:[],supplierCity:'',buyerCity:'',readMethod:'Falha na leitura',readError:error.message||'Falha na leitura.'};
    data.extraction=makeExtraction(data);return data;
  }
}
function showExtractionReview(item){
  const panel=$('extractionReview');const content=$('extractionReviewContent');
  if(!item){panel.classList.add('hidden');return;}
  const review=item.extraction||makeExtraction(item);
  const rows=review.fields.map(field=>`<div class="fact"><span>${safeText(field.label)}</span><strong>${field.value?safeText(field.value):'<em class="muted">Não identificado</em>'}</strong></div>`).join('');
  const taxes=(item.taxes||[]).length?`<div class="helper-line"><strong>Tributos lidos do XML (não significam retenção):</strong> ${item.taxes.map(t=>`${safeText(t.name)} ${brl(t.value)}`).join(' • ')}</div>`:'';
  content.innerHTML=`<div class="pill-row" style="margin:0 0 9px"><span class="chip ${review.foundCount>=6?'good':'warn'}">${review.foundCount}/${review.totalCount} campos identificados</span><span class="chip">${safeText(item.readMethod||'Leitura automática')}</span><span class="chip">${safeText(item.fileName||'')}</span></div><div class="result-facts">${rows}</div>${taxes}${item.readError?`<div class="notice warn" style="margin-top:10px"><i class="fa-solid fa-triangle-exclamation"></i><div>${safeText(item.readError)}</div></div>`:'<div class="notice success" style="margin-top:10px"><i class="fa-solid fa-check-circle"></i><div>Leitura inicial concluída. Confira os campos no formulário antes de calcular.</div></div>'}`;
  panel.classList.remove('hidden');
}
