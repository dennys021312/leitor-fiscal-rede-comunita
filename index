function assess(data){
  const rows=[];const pending=[];const notes=[];const warnings=[];let xmlTaxes=currentImportedTaxes.slice();
  if(!validCnpj(data.cnpj))pending.push('CNPJ não validado.');
  if(data.providerRegime==='unknown')pending.push('Regime tributário do prestador não confirmado.');
  if(data.docType==='nfse'){
    if(data.buyerType==='unknown') pending.push('Natureza do tomador não informada.');
    if(data.csrfStatus==='unknown') pending.push('Enquadramento de PIS/COFINS/CSLL não avaliado.');
    if(data.csrfStatus==='yes'){
      if(!['private','association'].includes(data.buyerType)){
        pending.push('Confirme a regra de retenção aplicável ao tomador: o cálculo padrão do art. 30 não foi aplicado.');
      }else if(data.providerRegime==='unknown'){
        pending.push('Confirme o Simples Nacional antes de calcular CSRF.');
      }else if(data.providerRegime==='simples'){
        notes.push('CSRF não calculada: a opção pelo Simples foi informada pelo usuário; a condição deve ser comprovada e validada.');
      }else{
        const amount=rounded(data.csrfBase*.0465);
        const finalAmount=amount<=10?0:amount;
        rows.push({name:'CSRF — PIS/COFINS/CSLL',base:data.csrfBase,rate:'4,65%',value:finalAmount,detail:amount<=10?'Dispensa por valor igual ou inferior a R$ 10,00 (conforme art. 31, §3º).':'Composição padrão: CSLL 1% + COFINS 3% + PIS/Pasep 0,65%.'});
        notes.push('CSRF calculada com base na hipótese informada de enquadramento no art. 30 da Lei 10.833/2003.');
      }
    } else if(data.csrfStatus==='no') notes.push('CSRF não aplicada: usuário informou atividade fora das hipóteses do art. 30.');

    if(data.inssStatus==='unknown') pending.push('Retenção previdenciária não avaliada.');
    if(data.inssStatus==='yes'){
      const value=truncated(data.inssBase*.11);
      rows.push({name:'INSS — retenção previdenciária',base:data.inssBase,rate:'11,00%',value,detail:'Regra geral informada para serviço enquadrado em cessão de mão de obra ou empreitada. Base e exceções precisam ser conferidas.'});
      notes.push('INSS calculado a 11% por enquadramento confirmado manualmente. Valor truncado em duas casas decimais para esta memória de cálculo.');
    }else if(data.inssStatus==='exempt') notes.push('INSS não aplicado: usuário declarou hipótese de dispensa legal confirmada. Exigir documentação comprobatória.');
    else notes.push('INSS não aplicado: usuário informou ausência de enquadramento previdenciário.');

    if(data.issStatus==='unknown') pending.push('Responsabilidade e retenção do ISS não avaliadas conforme legislação municipal.');
    if(data.issStatus==='yes'){
      if(!(data.issRate>0 && data.issRate<=100)) pending.push('Informe uma alíquota de ISS maior que zero e confirme a lei municipal.');
      else rows.push({name:'ISS — retenção municipal',base:data.issBase,rate:`${data.issRate.toLocaleString('pt-BR',{maximumFractionDigits:4})}%`,value:rounded(data.issBase*data.issRate/100),detail:`Alíquota informada pelo usuário. Município de referência: ${data.buyerCity}.`});
    }else if(data.issStatus==='no') notes.push('ISS não retido: usuário informou que o tomador não é responsável pela retenção.');

    if(data.irrfStatus==='unknown')pending.push('IRRF não avaliado.');
    if(data.irrfStatus==='custom' && !(data.irrfRate>0 && data.irrfRate<=100))pending.push('Informe a alíquota manual do IRRF.');
    if(['1','1.5','custom'].includes(data.irrfStatus) && data.irrfRate>0){
      rows.push({name:'IRRF — retenção informada',base:data.irrfBase,rate:`${data.irrfRate.toLocaleString('pt-BR',{maximumFractionDigits:4})}%`,value:rounded(data.irrfBase*data.irrfRate/100),detail:'Alíquota escolhida manualmente. Verifique natureza do serviço, beneficiário e legislação aplicável.'});
    }else if(data.irrfStatus==='no')notes.push('IRRF não aplicado: usuário informou que não há retenção para a operação.');
  }else if(data.docType==='nfe'){
    notes.push('Compra de mercadorias: não existe uma alíquota universal de retenção para aplicar ao valor da NF-e. Foram lidos, quando disponíveis, tributos destacados no XML, que não equivalem automaticamente a valores retidos pelo comprador.');
    if(!xmlTaxes.length)pending.push('XML da NF-e não foi identificado ou não trouxe campos tributários legíveis; conferir NCM, CFOP, CST/CSOSN, ICMS-ST, IPI e demais campos no documento.');
  }else{
    pending.push('Tipo de documento não permite concluir o enquadramento tributário automaticamente.');
  }
  if(!currentLookup || cnpjRaw(currentLookup.cnpj||'')!==cnpjRaw(data.cnpj)) pending.push('Consulta pública de CNPJ ainda não foi concluída para este fornecedor.');
  else if(String(currentLookup.status).toLowerCase()!=='ativa')warnings.push(`A base consultada informa situação cadastral: ${currentLookup.status}. Confirme na Receita Federal.`);
  const total=rounded(rows.reduce((sum,row)=>sum+row.value,0));
  const net=rounded(data.gross-total);
  if(total>data.gross)warnings.push('A soma das retenções calculadas supera o valor bruto. Verifique bases, percentuais e eventual duplicidade.');
  if(data.gross<=0)warnings.push('Valor bruto igual a zero ou não informado.');
  if(pending.length) return {status:'PENDENTE DE ENQUADRAMENTO',kind:'pending',rows,total,net,pending,notes,warnings,xmlTaxes};
  return {status:warnings.length?'ALERTA — REVISAR':'CÁLCULO INDICATIVO — REVISÃO CONTÁBIL',kind:warnings.length?'alert':'done',rows,total,net,pending,notes,warnings,xmlTaxes};
}
