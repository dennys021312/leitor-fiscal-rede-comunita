<script>
'use strict';
const $ = id => document.getElementById(id);
const brl = value => (Number(value)||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
const dateTimeBR = value => new Date(value || Date.now()).toLocaleString('pt-BR');
const safeText = value => String(value ?? '').replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
let cnpjCache = new Map();
let cnpjInFlight = new Map();
let currentLookup = null;
let currentImportedTaxes = [];
let formGeneration = 0;

if (window.pdfjsLib) pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

// Navegação entre módulos.
document.querySelectorAll('.tab').forEach(button => button.addEventListener('click', () => {
  document.querySelectorAll('.tab').forEach(b => b.classList.toggle('active', b === button));
  document.querySelectorAll('.view').forEach(v => v.classList.toggle('active', v.id === `view-${button.dataset.view}`));
}));

// CNPJ: 12 posições alfanuméricas + 2 DVs numéricos. Letras são convertidas por ASCII - 48.
function cnpjRaw(value){ return String(value||'').toUpperCase().replace(/[^0-9A-Z]/g,'').slice(0,14); }
function formatCnpj(value){
  const s = cnpjRaw(value);
  if(s.length<=2) return s;
  if(s.length<=5) return `${s.slice(0,2)}.${s.slice(2)}`;
  if(s.length<=8) return `${s.slice(0,2)}.${s.slice(2,5)}.${s.slice(5)}`;
  if(s.length<=12) return `${s.slice(0,2)}.${s.slice(2,5)}.${s.slice(5,8)}/${s.slice(8)}`;
  return `${s.slice(0,2)}.${s.slice(2,5)}.${s.slice(5,8)}/${s.slice(8,12)}-${s.slice(12)}`;
}
function cnpjDigit(base, weights){
  const sum = [...base].reduce((total,char,index)=> total + (char.charCodeAt(0)-48)*weights[index],0);
  const mod = sum % 11;
  return mod < 2 ? 0 : 11-mod;
}
function validCnpj(value){
  const c = cnpjRaw(value);
  if(c.length!==14 || !/^[0-9A-Z]{12}[0-9]{2}$/.test(c) || /^([0-9A-Z])\1+$/.test(c)) return false;
  const w1=[5,4,3,2,9,8,7,6,5,4,3,2];
  const w2=[6,5,4,3,2,9,8,7,6,5,4,3,2];
  const d1=cnpjDigit(c.slice(0,12),w1);
  const d2=cnpjDigit(c.slice(0,12)+d1,w2);
  return c.slice(12) === `${d1}${d2}`;
}
function bindCnpjInput(input){
  input.addEventListener('input',()=>{const pos=input.selectionStart;input.value=formatCnpj(input.value);try{input.setSelectionRange(input.value.length,input.value.length)}catch(_){}});
}
bindCnpjInput($('cnpj'));bindCnpjInput($('buyerCnpj'));bindCnpjInput($('lookupCnpj'));

function showInlineCnpj(message, kind='info'){
  const el=$('inlineCnpjStatus'); el.textContent=message; el.style.color=kind==='good'?'#176b45':kind==='bad'?'#a52d42':kind==='warn'?'#8a5c0d':'#617087';
}
function sourceStatus(title, detail, tag='Não consultado', live=false){
  const box=$('sourceStatus');
  const item=document.createElement('div'); item.className='source-item';
  const left=document.createElement('div'); const strong=document.createElement('strong');strong.textContent=title;const small=document.createElement('small');small.textContent=detail;left.append(strong,small);
  const badge=document.createElement('span');badge.className='source-tag'+(live?' live':'');badge.textContent=tag;item.append(left,badge);
  const old=[...box.children].find(n=>n.firstElementChild?.firstElementChild?.textContent===title);
  if(old) old.replaceWith(item); else box.prepend(item);
}
function situacaoLabel(raw){
  if(raw===undefined || raw===null || raw==='') return 'Não informado';
  const s=String(raw).trim();
  const map={'1':'Nula','2':'Ativa','3':'Suspensa','4':'Inapta','8':'Baixada'};
  return map[s] || s;
}
function simpleLabel(value){
  if(value===undefined || value===null || value==='') return '';
  const s=String(value).trim().toLowerCase();
  if(['sim','true','1','optante','optante pelo simples nacional'].includes(s)) return 'Optante';
  if(['não','nao','false','0','não optante','nao optante'].includes(s)) return 'Não optante';
  return String(value);
}
function normalizeBrasilApi(d){
  const simple = d.opcao_pelo_simples?.opcao_pelo_simples ?? d.opcao_pelo_simples?.simples ?? d.opcao_pelo_simples ?? d.simples;
  return {
    name:d.razao_social||d.nome_fantasia||'', fantasy:d.nome_fantasia||'', status:situacaoLabel(d.descricao_situacao_cadastral||d.situacao_cadastral),
    cnae:[d.cnae_fiscal,d.cnae_fiscal_descricao].filter(Boolean).join(' — '),
    city:[d.municipio,d.uf].filter(Boolean).join(' / '),
    simple:simpleLabel(simple ?? d.simples?.simples), mei:simpleLabel(d.opcao_pelo_mei?.mei ?? d.opcao_pelo_mei?.opcao_pelo_mei ?? d.opcao_pelo_mei),
    updated:d.atualizado_em||'', statusDate:d.data_situacao_cadastral||'', source:'BrasilAPI (base pública)',
    rawUpdated:d.atualizado_em||''
  };
}
function normalizeCnpjWs(d){
  const e=d.estabelecimento||{}; const principal=e.atividade_principal||{}; const simple=d.simples||{};
  return {
    name:d.razao_social||'', fantasy:e.nome_fantasia||'', status:situacaoLabel(e.situacao_cadastral),
    cnae:[principal.id,principal.descricao].filter(Boolean).join(' — '),
    city:[e.cidade?.nome,e.estado?.sigla].filter(Boolean).join(' / '),
    simple:simpleLabel(simple.simples), mei:simpleLabel(simple.mei),
    updated:simple.atualizado_em||e.atualizado_em||d.atualizado_em||'', source:'CNPJ.ws (base pública)', rawUpdated:''
  };
}
async function fetchJson(url,timeout=9000){
  const controller=new AbortController();const timer=setTimeout(()=>controller.abort(),timeout);
  try{const response=await fetch(url,{method:'GET',headers:{'Accept':'application/json'},signal:controller.signal,cache:'no-store'});
    if(!response.ok){const error=new Error(`HTTP ${response.status}`);error.status=response.status;throw error;}
    return await response.json();
  }finally{clearTimeout(timer);}
}
async function consultCnpj(value, target='form'){
  const generation=target==='form'?formGeneration:null;
  const c=cnpjRaw(value); const resultBox=target==='page' ? $('fullCnpjResult') : null;
  if(!validCnpj(c)){
    const message='CNPJ inválido: confira as 14 posições e os dígitos verificadores.';
    if(target==='form') showInlineCnpj(message,'bad');
    else {resultBox.classList.add('show');resultBox.innerHTML=`<div class="notice danger">${safeText(message)}</div>`;}
    sourceStatus('Consulta pública de CNPJ',message,'CNPJ inválido'); return null;
  }
  const cached=cnpjCache.get(c);
  if(cached && Date.now()-cached.time<120000){showCnpjOutput(cached.data,target,true);return cached.data;}
  const button=target==='page' ? $('btnLookupPage') : $('btnLookupCnpj');
  const original=button.innerHTML;button.disabled=true;button.innerHTML='<i class="fa-solid fa-spinner spinning"></i>Consultando';
  if(target==='form')showInlineCnpj('Consultando base pública de dados cadastrais…');
  else {resultBox.classList.add('show');resultBox.innerHTML='<div class="notice info"><i class="fa-solid fa-spinner spinning"></i> Consultando serviço público de dados…</div>';}
  sourceStatus('Consulta pública de CNPJ','Requisição em andamento.','Consultando');
  try{
    let request=cnpjInFlight.get(c);
    if(!request){
      request=(async()=>{
        let data=null;let lastError=null;
        try{
          const raw=await fetchJson(`https://brasilapi.com.br/api/cnpj/v1/${encodeURIComponent(c)}`);
          data=normalizeBrasilApi(raw);
          if(!data.name) throw new Error('Resposta sem razão social ou dados cadastrais essenciais');
        }catch(error){lastError=error;}
        if(!data && /^\d{14}$/.test(c)){
          try{const raw=await fetchJson(`https://publica.cnpj.ws/cnpj/${c}`);data=normalizeCnpjWs(raw);if(!data.name)throw new Error('Resposta sem razão social');}
          catch(error){lastError=error;}
        }
        if(!data) throw lastError||new Error('Nenhuma fonte pública retornou dados.');
        return {...data,cnpj:c,queriedAt:new Date().toISOString()};
      })();
      cnpjInFlight.set(c,request);
    }
    const data=await request;
    if(target==='form' && generation!==formGeneration)return null;
    cnpjCache.set(c,{data,time:Date.now()});
    showCnpjOutput(data,target,false);
    return data;
  }catch(error){
    if(target==='form' && generation!==formGeneration)return null;
    const detail=error.name==='AbortError'?'Tempo limite da consulta excedido.':error.status===429?'Limite de consultas atingido pela fonte pública.':error.message||'Falha de conexão.';
    const message=`Consulta não concluída: ${detail} Confira no portal oficial da Receita Federal.`;
    sourceStatus('Consulta pública de CNPJ',message,'Indisponível');
    if(target==='form')showInlineCnpj(message,'warn');
    else {resultBox.classList.add('show');resultBox.innerHTML=`<div class="notice warn">${safeText(message)} <a href="https://solucoes.receita.fazenda.gov.br/Servicos/cnpjreva/" target="_blank" rel="noopener">Abrir Receita Federal</a></div>`;}
    return null;
  }finally{
    cnpjInFlight.delete(c);button.disabled=false;button.innerHTML=original;
  }
}
function showCnpjOutput(data,target,fromCache){
  const updated=data.updated ? `Atualização informada pela base: ${data.updated}` : 'A base consultada não informou a data de atualização.';
  const cache=fromCache?'Resultado reutilizado da consulta recente. ':'';
  if(target==='form'){
    if(data.name && !$('companyName').value.trim()) $('companyName').value=data.name;
    if(data.city && !$('supplierCity').value.trim()) $('supplierCity').value=data.city;
    if(data.simple==='Optante') $('providerRegime').value='simples';
    else if(data.simple==='Não optante') $('providerRegime').value='normal';
    currentLookup={...data,queriedAt:new Date().toISOString()};
    showInlineCnpj(`${cache}${data.source} • ${data.status} • ${updated} Confirme o comprovante oficial.` ,data.status.toLowerCase()==='ativa'?'good':'warn');
  }else{
