});
function loadDocument(item){
  $('docType').value=item.docType||'outro';
  $('docNumber').value=item.docNumber||'';
  $('issueDate').value=normalizeDate(item.issueDate);
  $('cnpj').value=formatCnpj(item.cnpj||'');
  $('companyName').value=item.companyName||'';
  $('buyerName').value=item.buyerName||'';
  $('buyerCnpj').value=formatCnpj(item.buyerCnpj||'');
  $('providerRegime').value=item.providerRegime==='simples'?'simples':'unknown';
  if(item.issStatus)$('issStatus').value=item.issStatus;
  $('description').value=item.description||'';
  $('serviceCode').value=item.serviceCode||'';
  $('supplierCity').value=item.supplierCity||'';
  $('buyerCity').value=item.buyerCity||'';
  if(item.buyerName&&/associa[cç][aã]o|funda[cç][aã]o|osc/i.test(item.buyerName))$('buyerType').value='association';
  else if(item.buyerName)$('buyerType').value='private';
  if(item.gross!==null&&item.gross!==undefined)$('grossValue').value=item.gross;
  currentImportedTaxes=item.taxes||[];
  showExtractionReview(item);
  if(item.readError)showInlineCnpj(`Leitura assistida: ${item.readError}`,'warn');
  if(validCnpj(item.cnpj))consultCnpj(item.cnpj,'form');
}
function normalizeDate(value){
  if(!value)return '';let s=String(value);if(/^\d{4}-\d{2}-\d{2}/.test(s))return s.slice(0,10);const m=s.match(/^(\d{2})\/(\d{2})\/(\d{4})$/);return m?`${m[3]}-${m[2]}-${m[1]}`:'';
}

$('nfseKey').addEventListener('input',()=>{$('nfseKey').value=$('nfseKey').value.replace(/\D/g,'').slice(0,50);$('nfseKeyStatus').textContent=$('nfseKey').value.length===50?'Chave com 50 dígitos. Confirme a chave no documento.':`Caracteres informados: ${$('nfseKey').value.length}/50.`;});
