n;gap:15px}.status{font-size:10px;font-weight:900;text-transform:uppercase;letter-spacing:.05em;padding:7px 10px;border-radius:999px;border:1px solid}.status.pending{background:#fff7e8;color:#8c5d0e;border-color:#efdfb6}.status.done{background:#edf7f1;color:#176944;border-color:#cce7d7}.status.alert{background:#fff0f1;color:#992e3d;border-color:#efcbd0}.status.info{background:#edf4ff;color:#315c97;border-color:#d1e1fa}.metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px;margin:15px 0}.metric{border:1px solid #e6eaf0;border-radius:12px;padding:12px;background:#fcfdff;min-width:0}.metric span{display:block;color:#818b9a;text-transform:uppercase;font-weight:800;font-size:9px;letter-spacing:.08em;margin-bottom:7px}.metric strong{font:800 16px Manrope,sans-serif;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.metric.deduction strong{color:#aa3047}.metric.net strong{color:#147649}.retention-table{width:100%;border-collapse:collapse;font-size:11px}.retention-table th{text-align:left;color:#778292;background:#f5f7fa;font-size:9px;text-transform:uppercase;letter-spacing:.06em;padding:9px}.retention-table td{padding:10px 9px;border-bottom:1px solid #edf0f4}.retention-table td:last-child,.retention-table th:last-child{text-align:right;font-weight:800}.retention-table tfoot td{font-weight:900;background:#fafbfc}.report-box{background:#182233;color:#e6ebf3;border-radius:13px;padding:14px;margin-top:14px}.report-head{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:10px}.report-head strong{font-size:10px;letter-spacing:.07em;text-transform:uppercase;color:#f1cd82}.report-box textarea{width:100%;background:#111a28;color:#dbe3ee;border:1px solid #334154;border-radius:9px;padding:12px;font:10px/1.6 ui-monospace,monospace;min-height:230px;resize:vertical}.source-list{display:grid;gap:9px}.source-item{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;border:1px solid #e8ebf0;border-radius:11px;padding:11px 12px}.source-item strong{display:block;font-size:11px}.source-item small{display:block;color:#8290a0;font-size:10px;line-height:1.4;margin-top:4px}.source-tag{font-size:9px;border-radius:999px;background:#f1f4f8;color:#657184;padding:5px 7px;white-space:nowrap;font-weight:800}.source-tag.live{background:#e8f5ee;color:#176b45}.consult-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.query-result{display:none;margin-top:14px}.query-result.show{display:block}.result-facts{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:12px}.fact{background:#f7f9fb;border:1px solid #e9edf2;border-radius:10px;padding:10px}.fact span{font-size:9px;color:#8a94a1;text-transform:uppercase;letter-spacing:.06em;display:block;font-weight:800;margin-bottom:5px}.fact strong{font-size:11px;word-break:break-word}.pill-row{display:flex;gap:7px;flex-wrap:wrap;margin-top:8px}.chip{font-size:9px;font-weight:800;border-radius:999px;padding:6px 9px;background:#f0f3f7;color:#59677a}.chip.good{background:#e8f6ee;color:#176b45}.chip.bad{background:#fff0f1;color:#a52d42}.chip.warn{background:#fff6e6;color:#8a5c0d}.legal-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.legal-card{border:1px solid #e8ebf0;border-radius:13px;padding:14px;background:#fff}.legal-card h4{margin:0 0 7px;font:800 12px Manrope,sans-serif}.legal-card p{font-size:10px;color:#748093;line-height:1.5;min-height:42px;margin:0 0 10px}.legal-card a{font-size:10px;color:#7b2841;font-weight:800;text-decoration:none}.legal-card a:hover{text-decoration:underline}.footer{margin-top:24px;padding:16px;border-top:1px solid #e3e7ed;text-align:center;color:#8791a0;font-size:10px;line-height:1.6}.hidden{display:none!important}.spinning{animation:spin 1s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}
